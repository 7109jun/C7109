extern "C" { void c7_print_i64(i64 v); void c7_newline(); }
void pi(i64 v) { c7_print_i64(v); c7_newline(); }
i32 id(i32 x) { return x; }
i32 main() {
    mut i32[4] a = {10, 20, 30, 40};
    pi(a[0] as i64 + a[3] as i64);
    i32[] s = a[1..=3];
    pi(s[2] as i64);
    i32[] e = a[4..4];                    // empty slice at the end is valid
    pi(e.len as i64);
    i32[] all = a[0..4];
    pi(all[id(3)] as i64);
    Str t = "xyz";
    pi(t[2] as i64);
    mut i32 sum = 0;
    for (i in 0..4) { sum += a[i]; }
    pi(sum as i64);
    return 0;
}
