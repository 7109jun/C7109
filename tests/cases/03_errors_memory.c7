enum ParseError : u8 { Empty, BadDigit, Overflow }

Result<i32, ParseError> parse_i32(Str s) {
    if (s.len == 0) { return Err(ParseError::Empty); }
    mut i32 acc = 0;
    for (ch in s.chars()) {
        if (ch < '0' || ch > '9') { return Err(ParseError::BadDigit); }
        acc = acc * 10 + (ch as i32 - '0' as i32);
    }
    return Ok(acc);
}

Result<i32, ParseError> sum_two(Str a, Str b) {
    i32 x = try parse_i32(a);
    i32 y = try parse_i32(b);
    return Ok(x + y);
}

void show() {
    match (parse_i32("12x")) {
        Ok(v)  => print_i32(v);
        Err(e) => print_error(e);
    }
}

tagged union Shape {
    Circle(f64 radius),
    Rect(f64 w, f64 h),
    Empty,
}

f64 area(const Shape* s) {
    match (*s) {
        Circle(r)  => return 3.14159 * r * r;
        Rect(w, h) => return w * h;
        Empty      => return 0.0;
    }
}

i32 classify(i32 n) {
    match (n) {
        0 => return 0;
        1..=9 => { return 1; }
        _ => return 2;
    }
}

(i32, bool) divide(i32 a, i32 b) {
    if (b == 0) { return (0, false); }
    return (a / b, true);
}

bool parse_ok(Str s, out i32 result);

void use_out() {
    mut i32 v = 0;
    if (parse_ok("42", out v)) { }
    (i32, bool) t = divide(1, 2);
    i32 first = t.0;
}

Result<usize, IoError> read_all(Str path, mut u8* out_buf) {
    File f = try File::open(path);
    defer f.close();

    mut u8* tmp = alloc u8[4096];
    if (tmp == null) { return Err(IoError::OutOfMemory); }
    defer free[] tmp;

    return Ok(try f.read(tmp, 4096));
}

void memory() {
    mut i32* p = alloc i32;
    if (p == null) { return; }
    *p = 7;
    free p;

    mut f32* v = alloc f32[1024];
    free[] v;

    mut f32* z = alloc zeroed f32[16];
    Buffer* b = alloc Buffer(1024);
    Arena arena = Arena::init(buffer, 64 * 1024);
    mut Node* n = alloc(&arena) Node;
    free(&arena) n;
    arena.reset();
    free(p);
    b.drop();
}

class Buffer {
    mut u8* data;
    usize   size;

    init(usize n) { data = alloc u8[n]; size = n; }
    drop()        { free[] data; }
}

void asserts() {
    assert(x > 0, "x must be positive");
    if (bad) { panic("boom"); }
    unreachable();
    sizeof(i32);
    alignof(Point);
}
