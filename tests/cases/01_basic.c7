void flow(i32 n, i32 code) {
    if (n > 0) {
        f();
    } else if (n < 0) {
        g();
    } else {
        h();
    }
    mut i32 i = 0;
    while (i < 10) { i += 1; }
    do { i -= 1; } while (i > 0);
    for (mut i32 j = 0; j < n; j += 1) { continue; }
    for (j in 0..n) { }
    for (j in 0..=n) { }
    for (ch in text.chars()) { }
    switch (code) {
        case 1, 2, 3: handle_small(); break;
        case 4..=9:   handle_mid();   break;
        default:      handle_other();
    }
    outer: for (y in 0..h) {
        for (x in 0..w) {
            if (grid[y][x] == target) { break outer; }
        }
    }
    goto done;
done:
    return;
}
void add_arrays(noalias mut f32* dst, noalias const f32* a, noalias const f32* b, usize n) {
    for (mut usize i = 0; i < n; i += 1) {
        dst[i] = a[i] + b[i];
    }
}

