extern "C" {
    void c7_print_i64(i64 v);
    void c7_print_f64(f64 v);
    void c7_newline();
}
void pi(i64 v) { c7_print_i64(v); c7_newline(); }
void pf(f64 v) { c7_print_f64(v); c7_newline(); }

interface Comparable { i32 compare(const Self* other); }

impl Comparable for i32 {
    i32 compare(const i32* other) { return *self - *other; }
}
impl Comparable for f64 {
    i32 compare(const f64* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}

struct Point { i32 x; i32 y; }
impl Comparable for Point {
    i32 compare(const Point* other) { return (self->x + self->y) - (other->x + other->y); }
}

T max<T : Comparable>(T a, T b) { return a.compare(&b) >= 0 ? a : b; }
T id<T>(T x) { return x; }
void swap<T>(T* a, T* b) { T t = *a; *a = *b; *b = t; }
T first<T>(const T[] xs) { return xs[0]; }
T pick_max<T : Comparable>(const T[] xs) {
    mut T best = xs[0];
    for (x in xs) { if (x.compare(&best) > 0) { best = x; } }
    return best;
}
T twice_max<T : Comparable>(T a, T b) { return max(max(a, b), max(b, a)); }

i32 main() {
    pi(max(3, 5));
    pf(max(2.5, 1.5));
    Point pa = Point{ x: 1, y: 2 };
    Point pb = Point{ x: 3, y: 4 };
    Point pm = max(pa, pb);
    pi(pm.x * 10 + pm.y);
    pi(id(42));
    mut i32 a = 1;
    mut i32 b = 2;
    swap(&a, &b);
    pi(a); pi(b);
    mut Point p1 = Point{ x: 1, y: 2 };
    mut Point p2 = Point{ x: 3, y: 4 };
    swap(&p1, &p2);
    pi(p1.x); pi(p2.x);
    i32[4] arr = {3, 9, 4, 1};
    pi(first(arr));
    pi(pick_max(arr));
    f64[3] fs = {1.5, 0.5, 2.5};
    pf(pick_max(fs));
    pi(twice_max(10, 20));
    return 0;
}
