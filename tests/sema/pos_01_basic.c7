namespace demo;

i32 add(i32 a, i32 b) { return a + b; }

i32 sum(const i32[] xs) {
    mut i32 total = 0;
    for (x in xs) { total += x; }
    return total;
}

void vars() {
    i32 a = 10;
    mut i32 value = 10;
    value = value + 1;
    mut count = 0;
    count += 1;
    limit = 100u64;
    name = "c7";
    mut u8[16] buf = undefined;
    i32[4] arr = {1, 2, 3, 4};
    i32[] s = arr;
    i32[] t = arr[1..3];
    usize n = s.len;
    i64 big = 5_000_000_000;
    i32 small = big as i32;
    f64 pi = 3.14159;
    i32 k = pi as i32;
    u8 c = 300 as u8;
    usize addr = &big as usize;
    void* raw = addr as void*;
    i32 sh = 1 << 3 >> 1;
    bool b = a & 3 == 3;
    f32 f = 1;
    i64 widened = a;
    f64 w = f;
}

void ptrs() {
    i32 x = 5;
    mut i32 y = 6;
    const i32* p1 = &x;
    mut const i32* p2 = &x;
    i32* p3 = &y;
    mut i32* p4 = &y;
    *p4 = 7;
    *p3 = 8;
    p4 = p4 + 1;
    p2 = &x;
}

i32 flow(i32 n, i32 code) {
    mut i32 i = 0;
    while (i < 10) { i += 1; }
    do { i -= 1; } while (i > 0);
    for (mut i32 j = 0; j < n; j += 1) { continue; }
    for (j in 0..n) { i += j; }
    for (j in 0..=n) { i += j; }
    switch (code) {
        case 1, 2, 3: i += 1; break;
        case 4..=9: i += 2; break;
        default: i += 3;
    }
    outer: for (y in 0..n) {
        for (x in 0..n) {
            if (x == y) { break outer; }
        }
    }
    goto done;
done:
    return i;
}

i32 twice(i32 x) { return x * 2; }

void closures() {
    mut i32 total = 0;
    i32 base = 10;
    closure(i32) -> void add = (i32 x) -> void { total += x + base; };
    closure(i32) -> void add2 = [base, &total](i32 x) -> void { total += x + base; };
    add(1);
    add2(2);
    fn(i32) -> i32 fp = twice;
}

void memory() {
    mut i32* p = alloc i32;
    if (p == null) { return; }
    *p = 7;
    free p;
    mut f32* v = alloc f32[1024];
    free[] v;
    mut f32* z = alloc zeroed f32[16];
}

extern "C" { CInt puts(CStr s); }
void cinterop() { CInt r = puts(c"hello"); }

thread_local mut i32 errno_value = 0;
