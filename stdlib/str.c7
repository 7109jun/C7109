// std str: Str views, UTF-8 iteration, StrBuf (growable owning buffer).
namespace std;

impl Str {
    Chars chars() { return Chars{ s: *self, pos: 0 }; }
    CStr as_cstr() { return CStr{ ptr: self->ptr as const CChar* }; }
    bool empty() { return self->len == 0; }
    Str slice(usize lo, usize hi) { return Str{ ptr: self->ptr + lo, len: hi - lo }; }
    bool starts_with(Str prefix) {
        if (prefix.len > self->len) { return false; }
        return memcmp(self->ptr as const void*, prefix.ptr as const void*, prefix.len) == 0;
    }
}

bool operator==(Str a, Str b) {
    if (a.len != b.len) { return false; }
    return memcmp(a.ptr as const void*, b.ptr as const void*, a.len) == 0;
}
bool operator!=(Str a, Str b) { return !(a == b); }

impl Iterator<Char> for Chars {
    mut Option<Char> next() {
        if (pos >= s.len) { return None; }
        u8 b0 = s.ptr[pos];
        mut u32 cp = 0;
        mut usize n = 1;
        if (b0 < 0x80) { cp = b0 as u32; }
        else if (b0 < 0xE0) { cp = ((b0 as u32) & 0x1F) << 6 | ((s.ptr[pos + 1] as u32) & 0x3F); n = 2; }
        else if (b0 < 0xF0) {
            cp = ((b0 as u32) & 0x0F) << 12 | ((s.ptr[pos + 1] as u32) & 0x3F) << 6 | ((s.ptr[pos + 2] as u32) & 0x3F);
            n = 3;
        } else {
            cp = ((b0 as u32) & 0x07) << 18 | ((s.ptr[pos + 1] as u32) & 0x3F) << 12 | ((s.ptr[pos + 2] as u32) & 0x3F) << 6 | ((s.ptr[pos + 3] as u32) & 0x3F);
            n = 4;
        }
        pos += n;
        return Some(cp as Char);
    }
}

class StrBuf {
    priv mut u8* ptr;
    priv mut usize len;
    priv mut usize cap;

    pub init() { ptr = null; len = 0; cap = 0; }
    pub drop() { if (ptr != null) { free[] ptr; } }

    pub usize size() { return len; }
    pub Str as_str() { return Str{ ptr: ptr, len: len }; }
    pub CStr as_cstr() { return CStr{ ptr: ptr as const CChar* }; }

    pub mut bool reserve(usize extra) {
        if (len + extra + 1 <= cap) { return true; }
        mut usize ncap = cap * 2;
        if (ncap < len + extra + 1) { ncap = len + extra + 1; }
        if (ncap < 16) { ncap = 16; }
        mut u8* np = alloc u8[ncap];
        if (np == null) { return false; }
        if (ptr != null) {
            memcpy(np as void*, ptr as const void*, len);
            free[] ptr;
        }
        ptr = np;
        cap = ncap;
        return true;
    }

    pub mut bool append(Str s) {
        if (!reserve(s.len)) { return false; }
        memcpy((ptr + len) as void*, s.ptr as const void*, s.len);
        len += s.len;
        ptr[len] = 0;
        return true;
    }

    pub mut bool push_char(Char c) {
        if (!reserve(4)) { return false; }
        u32 cp = c as u32;
        if (cp < 0x80) { ptr[len] = cp as u8; len += 1; }
        else if (cp < 0x800) { ptr[len] = (0xC0 | (cp >> 6)) as u8; ptr[len + 1] = (0x80 | (cp & 0x3F)) as u8; len += 2; }
        else if (cp < 0x10000) {
            ptr[len] = (0xE0 | (cp >> 12)) as u8; ptr[len + 1] = (0x80 | ((cp >> 6) & 0x3F)) as u8; ptr[len + 2] = (0x80 | (cp & 0x3F)) as u8;
            len += 3;
        } else {
            ptr[len] = (0xF0 | (cp >> 18)) as u8; ptr[len + 1] = (0x80 | ((cp >> 12) & 0x3F)) as u8;
            ptr[len + 2] = (0x80 | ((cp >> 6) & 0x3F)) as u8; ptr[len + 3] = (0x80 | (cp & 0x3F)) as u8;
            len += 4;
        }
        ptr[len] = 0;
        return true;
    }

    pub mut void clear() { len = 0; if (ptr != null) { ptr[0] = 0; } }
}
